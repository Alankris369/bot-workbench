# 复制为 .env 后填真实值；.env 不要提交到 Git。
# 工作台前端令牌存在浏览器 localStorage，一般不需要本文件。
# 中转站 / Bot 上报、Cloudflare 部署时用这些变量。

# Bot 上报与下指令共用的 Bearer 令牌（原 /workspace/relay/.report-token）
REPORT_TOKEN=

# Cloudflare Worker 转发到 Grok Bot routine webhook
WEBHOOK_URL=
WEBHOOK_KEY=

# 可选：用 wrangler / API 部署 Worker 时
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
